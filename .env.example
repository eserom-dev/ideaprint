# =====================================================================
# IDEAPRINT: Environment Configuration Example
# Copy this file to .env.local and fill in your actual credentials.
# =====================================================================

# 1. Supabase Database & Auth (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-token
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key

# 2. Dual AI Gateway Providers
# Google Gemini (Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Groq Cloud API
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
